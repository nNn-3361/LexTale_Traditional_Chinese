{
  "name": "lextale-tc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "beta:prepare": "node scripts/prepare-beta-bank.mjs",
    "beta:dev": "npm run beta:prepare && vite --config vite.beta.config.ts",
    "beta:build": "tsc --noEmit && npm run beta:prepare && vite build --config vite.beta.config.ts",
    "pilot:dev": "npm run beta:prepare && vite --config vite.pilot.config.ts",
    "pilot:build": "tsc --noEmit && npm run beta:prepare && vite build --config vite.pilot.config.ts && node scripts/rename-pilot-index.mjs"
  },
  "dependencies": {
    "@jspsych/plugin-html-button-response": "2.1.0",
    "@jspsych/plugin-html-keyboard-response": "2.2.0",
    "@jspsych/plugin-instructions": "2.1.0",
    "@jspsych/plugin-preload": "2.1.0",
    "@jspsych/plugin-survey-text": "2.1.1",
    "jspsych": "8.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
